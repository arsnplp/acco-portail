# ── Supabase (Project Settings → API / Database). Région UE obligatoire.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # secret, serveur uniquement
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=              # token personnel (CLI / API de gestion), optionnel

# ── Prisma
DATABASE_URL=postgresql://postgres.<ref>:<mdp>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:<mdp>@db.<ref>.supabase.co:5432/postgres

# ── App
NEXT_PUBLIC_APP_URL=http://localhost:3000   # en prod : https://app.acco-lab.fr

# ── Emails (Resend) — étape 5
RESEND_API_KEY=
EMAIL_FROM="Acco <contact@acco-lab.fr>"

# ── Anti-spam formulaires (Cloudflare Turnstile) — étape 5
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── IA (récaps mensuels, réponses aux avis) — étapes 6-7. Vide = gabarits en français (mode développement).
ANTHROPIC_API_KEY=

# ── Google OAuth (recommandé) : Paramètres → « Connecter Google » avec le compte Acco
# console.cloud.google.com → API et services → Identifiants → ID client OAuth (Application Web)
# URI de redirection : <NEXT_PUBLIC_APP_URL>/api/google/callback ; API à activer : Search Console API, My Business (étape 7)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Google par compte de service (alternative si les clés sont autorisées dans votre organisation)
# 1. console.cloud.google.com → projet → API « Google Search Console API » activée
# 2. IAM → Comptes de service → créer → clé JSON
# 3. Ajouter l'email du compte de service comme utilisateur (lecture) sur chaque propriété Search Console
# 4. Coller le JSON sur une seule ligne ci-dessous. Vide = mode démo (chiffres simulés).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Web Push (npx web-push generate-vapid-keys) — étape 5
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # même valeur que VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=

# ── Secret partagé pour les tâches planifiées. Cron du VPS le 4 de chaque mois à 7h :
#   0 7 4 * * curl -s -H "Authorization: Bearer $CRON_SECRET" https://app.acco-lab.fr/api/cron/recaps
CRON_SECRET=
