# ── Supabase (Project Settings → API / Database). Région UE obligatoire.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # secret, serveur uniquement
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=              # token personnel (CLI / API de gestion), optionnel

# ── Prisma
DATABASE_URL=postgresql://postgres.<ref>:<mdp>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:<mdp>@db.<ref>.supabase.co:5432/postgres

# ── App
NEXT_PUBLIC_APP_URL=http://localhost:3000   # en prod : https://app.acco-lab.fr

# ── Emails (Resend) — étape 5
RESEND_API_KEY=
EMAIL_FROM="Acco <contact@acco-lab.fr>"

# ── Anti-spam formulaires (Cloudflare Turnstile) — étape 5
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── IA (récaps mensuels, réponses aux avis) — étapes 6-7
ANTHROPIC_API_KEY=

# ── Google (Search Console + Business Profile) : JSON du compte de service, sur une ligne — étapes 6-7
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Web Push (npx web-push generate-vapid-keys) — étape 5
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Secret partagé pour les tâches planifiées (/api/cron/*) — étape 6
CRON_SECRET=
