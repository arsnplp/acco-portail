// Portail client Acco — schéma de données
// Base : PostgreSQL (Supabase, eu-central-1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Énumérations
// ─────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
  COMMERCIAL // équipe (alternants, commerciaux) : accès à l'espace Commercial uniquement
}

enum MembershipRole {
  OWNER // gérant
  MEMBER // employé invité
}

enum SiteStatus {
  EN_CREATION
  EN_LIGNE
  SUSPENDU
}

enum ProjectStep {
  BRIEF
  MAQUETTE
  DEVELOPPEMENT
  MISE_EN_LIGNE
}

enum AssetKind {
  LOGO
  TEXTE
  PHOTO
  AUTRE
}

enum HistoryKind {
  CREATION // récap de ce qui a été fait à la création
  INTERVENTION // intervention datée
  MISE_EN_LIGNE
}

enum ContactRequestStatus {
  NOUVELLE
  TRAITEE
  DEVENU_CLIENT
}

enum ChangeRequestStatus {
  RECUE
  EN_COURS
  A_VALIDER // Claude a terminé, en attente de validation par l'équipe
  TERMINEE
}

/// Suivi du travail de Claude Code sur une demande de modification (worker local, scripts/claude-worker.ts).
enum ClaudeJobState {
  EN_FILE // confiée à Claude, en attente du worker
  EN_TRAVAIL // Claude modifie le site
  PRET // modifs poussées sur la branche, aperçu disponible
  MISE_EN_LIGNE_DEMANDEE // validée : à fusionner dans la branche principale
  EN_LIGNE // fusionnée et poussée, le serveur publie
  ERREUR
  ANNULATION_DEMANDEE // l'équipe refuse le travail de Claude : le worker supprime la branche et l'aperçu
}

enum Urgency {
  NORMALE
  URGENTE
}

enum ReviewSource {
  GOOGLE
  DEMO
}

enum Module {
  NONE
  AVIS
}

enum Billing {
  PONCTUEL
  MENSUEL
}

enum OrderStatus {
  A_TRAITER
  VALIDEE
  REFUSEE
}

enum SubscriptionStatus {
  ACTIF
  RESILIE
}

enum DocumentKind {
  CONTRAT
  FACTURE
  DEVIS
  AUTRE
}

enum ReferralKind {
  LIEN
  CONTACT
}

enum ReferralStatus {
  ENVOYEE
  CONTACTEE
  SIGNEE
  RECOMPENSE_VALIDEE
}

enum ReviewPromptState {
  AFFICHEE
  IGNOREE
  CLIQUEE
}

enum NotificationKind {
  DEMANDE_CONTACT
  NOUVEL_AVIS
  MODIFICATION_TERMINEE
  RECAP_MENSUEL
  MESSAGE_EQUIPE
  SITE_EN_LIGNE
  COMMANDE_VALIDEE
  RECOMPENSE_PARRAINAGE
  ALERTE_SITE
  DOCUMENT_DISPONIBLE
  DOCUMENT_DEMANDE
}

/// VERS_EQUIPE : le client demande un document à Acco. VERS_CLIENT : Acco demande un document au client.
enum DocumentRequestDirection {
  VERS_EQUIPE
  VERS_CLIENT
}

enum DocumentRequestStatus {
  EN_ATTENTE
  TERMINEE
}

// ─────────────────────────────────────────────────────────────
// Comptes
// ─────────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  name      String // raison sociale / enseigne
  siren     String?
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      ClientMembership[]
  invitations      Invitation[]
  sites            Site[]
  orders           Order[]
  subscriptions    Subscription[]
  conversation     Conversation?
  documents        Document[]
  documentRequests DocumentRequest[]
  referralsMade    Referral[]         @relation("ReferralsMade")
  referredBy       Referral?          @relation("ReferredClient")
  reviewPrompts    ReviewPrompt[]
  notifications    Notification[]
  referralCode     String             @unique @default(cuid())
  crmProspect      Prospect?
  crmEchanges      Echange[]
  crmProjets       Projet[]
}

model User {
  id        String   @id // = auth.users.id (Supabase Auth)
  email     String   @unique
  firstName String?
  lastName  String?
  avatarUrl String?
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       ClientMembership[]
  invitationsSent   Invitation[]
  messages          Message[]
  assignedChanges   ChangeRequest[]         @relation("AssignedChanges")
  changeComments    ChangeRequestComment[]
  pushSubscriptions PushSubscription[]
  notificationPref  NotificationPreference?
  historyEntries    SiteHistoryEntry[]
  validatedOrders   Order[]                 @relation("ValidatedOrders")
  documentRequests  DocumentRequest[]
  crmProspects      Prospect[]              @relation("ProspectCommercial")
  crmEchanges       Echange[]               @relation("EchangeAuteur")
  crmRendezVous     RendezVous[]            @relation("RdvCommercial")
  crmProjets        Projet[]                @relation("ProjetResponsable")
  crmTaches         Tache[]                 @relation("TacheResponsable")
  crmTacheModeles   TacheModele[]           @relation("TacheModeleResponsable")
}

model ClientMembership {
  id        String         @id @default(cuid())
  clientId  String
  userId    String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([userId])
}

model Invitation {
  id         String    @id @default(cuid())
  clientId   String
  email      String
  token      String    @unique @default(cuid())
  invitedBy  String?
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  inviter User?  @relation(fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────
// Sites
// ─────────────────────────────────────────────────────────────

model Site {
  id                String      @id @default(cuid())
  clientId          String
  name              String
  url               String? // URL de production
  previewUrl        String? // lien préprod
  screenshotUrl     String?
  status            SiteStatus  @default(EN_CREATION)
  projectStep       ProjectStep @default(BRIEF)
  mockupValidatedAt DateTime?
  launchedAt        DateTime?
  siteKey           String      @unique @default(cuid()) // clé des formulaires
  searchConsoleProp String? // ex. sc-domain:example.fr
  googleLocationId  String? // fiche Google Business Profile
  reviewsSyncedAt   DateTime?
  reviewAverage     Float?
  reviewTotal       Int?
  repoUrl           String? // dépôt GitHub du site, ex. https://github.com/arsnplp/swella.git
  repoBranch        String? // branche publiée (défaut : main)
  repoRoot          String? // sous-dossier servi en ligne (ex. « site »), vide = racine
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  client           Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assets           SiteAsset[]
  history          SiteHistoryEntry[]
  healthChecks     SiteHealthCheck[]
  contactRequests  ContactRequest[]
  searchStats      SearchStatsMonthly[]
  recaps           MonthlyRecap[]
  reviews          Review[]
  changeRequests   ChangeRequest[]
  guideProgress    GuideProgress[]
  subscriptions    Subscription[]
  orders           Order[]
  messages         Message[]
  documents        Document[]
  documentRequests DocumentRequest[]
  notifications    Notification[]
  crmProjets       Projet[]

  @@index([clientId])
}

model SiteAsset {
  id          String    @id @default(cuid())
  siteId      String
  kind        AssetKind
  label       String // "Logo", "Textes de la page d'accueil", ...
  storagePath String? // null = pas encore fourni
  fileName    String?
  uploadedAt  DateTime?
  createdAt   DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model SiteHistoryEntry {
  id          String      @id @default(cuid())
  siteId      String
  kind        HistoryKind
  title       String
  description String?
  items       String[] // puces (pages créées, SEO technique, ...)
  happenedAt  DateTime    @default(now())
  authorId    String?
  createdAt   DateTime    @default(now())

  site   Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([siteId, happenedAt])
}

model SiteHealthCheck {
  id           String    @id @default(cuid())
  siteId       String
  isUp         Boolean
  statusCode   Int?
  responseMs   Int?
  sslExpiresAt DateTime?
  checkedAt    DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, checkedAt])
}

// ─────────────────────────────────────────────────────────────
// Activité (formulaires des sites) — RGPD : purge à 24 mois
// ─────────────────────────────────────────────────────────────

model ContactRequest {
  id        String               @id @default(cuid())
  siteId    String
  name      String
  email     String?
  phone     String?
  type      String? // "Devis", "Rendez-vous", "Question"...
  message   String
  pageUrl   String?
  status    ContactRequestStatus @default(NOUVELLE)
  handledAt DateTime?
  createdAt DateTime             @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Résultats (Search Console)
// ─────────────────────────────────────────────────────────────

model SearchStatsMonthly {
  id          String   @id @default(cuid())
  siteId      String
  year        Int
  month       Int // 1-12
  clicks      Int // visites depuis Google
  impressions Int // apparitions
  position    Float // position moyenne
  topQueries  Json // [{ query, clicks, impressions, position }]
  createdAt   DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, year, month])
}

model MonthlyRecap {
  id           String    @id @default(cuid())
  siteId       String
  year         Int
  month        Int
  summary      String // 3 phrases générées par l'IA
  contactCount Int       @default(0)
  reviewCount  Int       @default(0)
  clicks       Int       @default(0)
  isPositive   Boolean   @default(false)
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, year, month])
}

// ─────────────────────────────────────────────────────────────
// Avis (module AVIS)
// ─────────────────────────────────────────────────────────────

model Review {
  id             String       @id @default(cuid())
  siteId         String
  source         ReviewSource @default(DEMO)
  externalId     String? // id Google
  authorName     String
  authorPhotoUrl String?
  rating         Int // 1-5
  text           String?
  reply          String?
  repliedAt      DateTime?
  suggestedReply String?
  publishedAt    DateTime
  createdAt      DateTime     @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, externalId])
  @@index([siteId, publishedAt])
}

// ─────────────────────────────────────────────────────────────
// Demandes de modification
// ─────────────────────────────────────────────────────────────

model ChangeRequest {
  id          String              @id @default(cuid())
  siteId      String
  title       String
  description String
  page        String?
  urgency     Urgency             @default(NORMALE)
  status      ChangeRequestStatus @default(RECUE)
  assigneeId  String?
  startedAt   DateTime?
  completedAt DateTime?
  confirmedAt DateTime? // le client confirme
  reopenedAt  DateTime?

  // Claude Code
  claudeState      ClaudeJobState?
  claudeBranch     String? // ex. claude/<id>
  claudeSummary    String? // compte rendu de Claude
  claudeFeedback   String? // consignes de l'équipe pour refaire
  claudeError      String?
  claudePreviewUrl String? // lien d'aperçu (localhost sur la machine du worker)
  claudeCompareUrl String? // diff GitHub
  claudeStartedAt  DateTime?
  claudeFinishedAt DateTime?
  claudeMergedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site        Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignee    User?                     @relation("AssignedChanges", fields: [assigneeId], references: [id], onDelete: SetNull)
  attachments ChangeRequestAttachment[]
  comments    ChangeRequestComment[]

  @@index([siteId, status])
  @@index([status])
  @@index([claudeState])
}

model ChangeRequestAttachment {
  id              String   @id @default(cuid())
  changeRequestId String
  storagePath     String
  fileName        String
  mimeType        String?
  createdAt       DateTime @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId])
}

model ChangeRequestComment {
  id              String   @id @default(cuid())
  changeRequestId String
  authorId        String?
  body            String
  createdAt       DateTime @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([changeRequestId])
}

// ─────────────────────────────────────────────────────────────
// Conseils
// ─────────────────────────────────────────────────────────────

model Guide {
  id          String   @id @default(cuid())
  slug        String   @unique
  emoji       String?
  title       String
  intro       String
  steps       String[] // cases à cocher
  offerId     String? // « On s'en occupe pour vous »
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  offer    Offer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  progress GuideProgress[]
}

model GuideProgress {
  id           String   @id @default(cuid())
  guideId      String
  siteId       String
  checkedSteps Int[] // index des étapes cochées
  updatedAt    DateTime @updatedAt

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  site  Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([guideId, siteId])
}

// ─────────────────────────────────────────────────────────────
// Offres, promos, commandes, abonnements
// ─────────────────────────────────────────────────────────────

model Offer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  benefit     String // bénéfice en une phrase
  description String?
  priceCents  Int
  setupCents  Int? // prix fixe (ex. plaquette NFC) en plus du mensuel
  billing     Billing
  module      Module   @default(NONE)
  isArchived  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  promotions    Promotion[]
  orders        Order[]
  subscriptions Subscription[]
  guides        Guide[]
}

model Promotion {
  id              String   @id @default(cuid())
  offerId         String
  label           String // "Offre de rentrée"
  promoPriceCents Int? // prix barré → nouveau prix
  percentOff      Int? // ou remise en %
  startsAt        DateTime @default(now())
  endsAt          DateTime
  createdAt       DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([endsAt])
}

model Order {
  id            String      @id @default(cuid())
  clientId      String
  offerId       String
  siteId        String? // site choisi pour le module
  status        OrderStatus @default(A_TRAITER)
  note          String?
  validatedById String?
  validatedAt   DateTime?
  createdAt     DateTime    @default(now())

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offer       Offer  @relation(fields: [offerId], references: [id])
  site        Site?  @relation(fields: [siteId], references: [id], onDelete: SetNull)
  validatedBy User?  @relation("ValidatedOrders", fields: [validatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([clientId])
}

model Subscription {
  id               String             @id @default(cuid())
  clientId         String
  siteId           String?
  offerId          String?
  label            String // "Site vitrine — abonnement", "Module Avis Google"
  module           Module             @default(NONE)
  billing          Billing
  priceCents       Int
  monthlyQuota     Int? // quota de modifications / mois
  status           SubscriptionStatus @default(ACTIF)
  startedAt        DateTime           @default(now())
  commitmentEndsAt DateTime? // fin d'engagement
  cancelledAt      DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  offer  Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([siteId, module, status])
}

// ─────────────────────────────────────────────────────────────
// Messages
// ─────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  clientId      String    @unique
  lastMessageAt DateTime?
  clientReadAt  DateTime?
  teamReadAt    DateTime?
  createdAt     DateTime  @default(now())

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String?
  siteId         String?
  body           String
  attachments    Json? // [{ storagePath, fileName, mimeType }]
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Documents
// ─────────────────────────────────────────────────────────────

model Document {
  id               String       @id @default(cuid())
  clientId         String
  siteId           String?
  kind             DocumentKind
  title            String
  storagePath      String
  fileName         String
  sizeBytes        Int?
  uploadedByClient Boolean      @default(false)
  createdAt        DateTime     @default(now())

  client  Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site    Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  request DocumentRequest?

  @@index([clientId])
  @@index([siteId])
}

/// Demande de document faite par le client (ex. « ma facture de septembre »)
model DocumentRequest {
  id          String                   @id @default(cuid())
  clientId    String
  siteId      String?
  kind        DocumentKind
  message     String?
  status      DocumentRequestStatus    @default(EN_ATTENTE)
  direction   DocumentRequestDirection @default(VERS_EQUIPE)
  requestedBy String?
  documentId  String?                  @unique
  fulfilledAt DateTime?
  createdAt   DateTime                 @default(now())

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site      Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  requester User?     @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Parrainage et avis sur Acco
// ─────────────────────────────────────────────────────────────

model Referral {
  id               String         @id @default(cuid())
  referrerClientId String
  kind             ReferralKind
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  note             String?
  referredClientId String?        @unique // rempli quand le filleul crée son compte
  status           ReferralStatus @default(ENVOYEE)
  rewardLabel      String?
  rewardedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  referrer Client  @relation("ReferralsMade", fields: [referrerClientId], references: [id], onDelete: Cascade)
  referred Client? @relation("ReferredClient", fields: [referredClientId], references: [id], onDelete: SetNull)

  @@index([referrerClientId])
}

model ReviewPrompt {
  id       String            @id @default(cuid())
  clientId String
  trigger  String // "SITE_EN_LIGNE", "MODIFICATION_CONFIRMEE", "RECAP_POSITIF"
  state    ReviewPromptState @default(AFFICHEE)
  shownAt  DateTime          @default(now())
  actedAt  DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, shownAt])
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  clientId  String
  siteId    String?
  kind      NotificationKind
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  userId          String  @id
  pushEnabled     Boolean @default(true)
  emailEnabled    Boolean @default(true)
  contactRequests Boolean @default(true)
  reviews         Boolean @default(true)
  changes         Boolean @default(true)
  recaps          Boolean @default(true)
  messages        Boolean @default(true)
  offers          Boolean @default(true)
  documents       Boolean @default(true) // client : document mis à disposition / admin : document envoyé par un client
  referrals       Boolean @default(true) // admin : nouvelle recommandation

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Paramètres de l'agence
// ─────────────────────────────────────────────────────────────

model Setting {
  key       String   @id // "google_review_url", "referral_reward_label", ...
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Espace Commercial (CRM) : prospection et production.
// Tables à part : rien ici ne modifie le fonctionnement du portail.
// ─────────────────────────────────────────────────────────────

enum ProspectStatut {
  A_CONTACTER
  A_RELANCER
  POSER_RDV
  RDV_POSE
  A_SIGNER
  GAGNE
  PERDU
}

enum ProspectSource {
  COLD_CALL
  PROSPECTION_PHYSIQUE
  RECOMMANDATION
  SITE_WEB
  AUTRE
}

enum EchangeType {
  NRP // ne répond pas
  APPEL
  MAIL
  PP // prospection physique
  RDV // le rendez-vous a eu lieu
  PRISE_RDV
  NOTE
}

enum RdvResultat {
  PREVU
  FAIT
  ANNULE
}

enum Priorite {
  BASSE
  MOYENNE
  HAUTE
}

enum ProjetStatut {
  A_FAIRE
  EN_COURS
  EN_PAUSE
  TERMINE
}

enum TacheStatut {
  A_FAIRE
  EN_COURS
  FAIT
}

enum Recurrence {
  PONCTUEL
  HEBDOMADAIRE
  MENSUEL_FIXE // le N du mois
  MENSUEL_RELATIF // le 1er lundi du mois…
}

model Cible {
  id        String     @id @default(cuid())
  nom       String     @unique
  createdAt DateTime   @default(now())
  prospects Prospect[]
}

model Prospect {
  id                 String          @id @default(cuid())
  legacyId           String?         @unique // ID de l'ancien CRM (import)
  societe            String
  siren              String?
  siret              String?
  dirigeant          String?
  adresse            String?
  siteWeb            String?
  telephone          String?
  cibleId            String?
  source             ProspectSource?
  statut             ProspectStatut  @default(A_CONTACTER)
  motifPerte         String?
  potentielEuros     Int? // potentiel mensuel estimé
  fraisCreationEuros Int? // signé : frais de création
  mensuelEuros       Int? // signé : abonnement mensuel
  commercialId       String?
  relanceAt          DateTime?
  clientId           String?         @unique // rempli quand le prospect devient client du portail
  gagneAt            DateTime?
  perduAt            DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  cible      Cible?            @relation(fields: [cibleId], references: [id], onDelete: SetNull)
  commercial User?             @relation("ProspectCommercial", fields: [commercialId], references: [id], onDelete: SetNull)
  client     Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contacts   ProspectContact[]
  echanges   Echange[]
  rendezVous RendezVous[]

  @@index([statut, relanceAt])
  @@index([commercialId])
  @@index([siren])
  @@index([telephone])
}

model ProspectContact {
  id         String   @id @default(cuid())
  prospectId String
  prenom     String?
  nom        String?
  fonction   String?
  email      String?
  telephone  String?
  principal  Boolean  @default(false)
  createdAt  DateTime @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
}

model Echange {
  id         String      @id @default(cuid())
  legacyId   String?     @unique
  prospectId String?
  clientId   String? // échange avec un client sans fiche prospect (historique importé)
  type       EchangeType
  notes      String?
  date       DateTime    @default(now())
  auteurId   String?
  auteurNom  String? // auteur externe (mail entrant)
  origine    String      @default("saisie") // saisie, import, gmail
  createdAt  DateTime    @default(now())

  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  auteur   User?     @relation("EchangeAuteur", fields: [auteurId], references: [id], onDelete: SetNull)

  @@index([prospectId, date])
  @@index([clientId, date])
  @@index([auteurId, date])
}

model RendezVous {
  id           String      @id @default(cuid())
  prospectId   String
  commercialId String?
  debut        DateTime
  dureeMin     Int         @default(60)
  lieu         String?
  resultat     RdvResultat @default(PREVU)
  createdAt    DateTime    @default(now())

  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  commercial User?    @relation("RdvCommercial", fields: [commercialId], references: [id], onDelete: SetNull)

  @@index([debut])
}

model ProjetModele {
  id          String        @id @default(cuid())
  legacyId    String?       @unique
  nom         String
  description String?
  createdAt   DateTime      @default(now())
  taches      TacheModele[]
  projets     Projet[]
}

model TacheModele {
  id            String     @id @default(cuid())
  legacyId      String?    @unique
  modeleId      String
  titre         String
  description   String?
  responsableId String?
  priorite      Priorite   @default(MOYENNE)
  recurrence    Recurrence @default(PONCTUEL)
  jourSemaine   Int? // 1 = lundi … 7 = dimanche
  jourMois      Int? // 1 … 31
  positionMois  Int? // 1 = 1er … 5 = dernier (avec jourSemaine)
  delaiJours    Int        @default(0) // échéance = début du projet + délai
  ordre         Int        @default(0)

  modele      ProjetModele      @relation(fields: [modeleId], references: [id], onDelete: Cascade)
  responsable User?             @relation("TacheModeleResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  sousTaches  SousTacheModele[]
  taches      Tache[]

  @@index([modeleId])
}

model SousTacheModele {
  id       String  @id @default(cuid())
  legacyId String? @unique
  tacheId  String
  intitule String
  ordre    Int     @default(0)

  tache TacheModele @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@index([tacheId])
}

model Projet {
  id            String       @id @default(cuid())
  legacyId      String?      @unique
  clientId      String?
  siteId        String?
  modeleId      String?
  nom           String
  description   String?
  statut        ProjetStatut @default(EN_COURS)
  priorite      Priorite     @default(MOYENNE)
  debut         DateTime?
  echeance      DateTime?
  responsableId String?
  brief         Json? // formulaire de cadrage
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  site        Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  modele      ProjetModele? @relation(fields: [modeleId], references: [id], onDelete: SetNull)
  responsable User?         @relation("ProjetResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  taches      Tache[]

  @@index([clientId])
}

model Tache {
  id            String      @id @default(cuid())
  legacyId      String?     @unique
  projetId      String?
  modeleId      String?
  titre         String
  description   String?
  responsableId String?
  statut        TacheStatut @default(A_FAIRE)
  priorite      Priorite    @default(MOYENNE)
  debut         DateTime?
  echeance      DateTime?
  faitLe        DateTime?
  recurrence    Recurrence  @default(PONCTUEL)
  jourSemaine   Int?
  jourMois      Int?
  positionMois  Int?
  ordre         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  projet      Projet?      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  modele      TacheModele? @relation(fields: [modeleId], references: [id], onDelete: SetNull)
  responsable User?        @relation("TacheResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  sousTaches  SousTache[]

  @@index([responsableId, statut, echeance])
  @@index([projetId])
}

model SousTache {
  id       String  @id @default(cuid())
  legacyId String? @unique
  tacheId  String
  titre    String
  fait     Boolean @default(false)
  ordre    Int     @default(0)

  tache Tache @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@index([tacheId])
}
