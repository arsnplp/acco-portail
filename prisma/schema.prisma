// Portail client Acco — schéma de données
// Base : PostgreSQL (Supabase, eu-central-1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Énumérations
// ─────────────────────────────────────────────────────────────

/// Rôles. Modules : Pilotage (ADMIN), Prospection (ADMIN, COMMERCIAL), Suivi (toute l'équipe), Espace client (CLIENT).
enum Role {
  CLIENT
  ADMIN // Direction : accès total
  COMMERCIAL // commerciaux, alternants : Prospection + Suivi
  DEV // développeurs : Suivi
  EXPERT // prestataires externes : Suivi
  SPECIALISTE // profils internes (SEO, Ads…) : Suivi
}

/// Vue de travail (distincte des droits) : page d'accueil et menus mis en avant.
enum Mode {
  COMMERCIAL
  DIRECTION
  PRODUCTION
  ADMIN
}

enum ClientStatut {
  ACTIF
  SUSPENDU
  ARCHIVE
}

/// Contrat : brouillon → envoyé → consulté → signé (ou refusé) ; terminé en fin d'engagement ou résiliation.
enum ContratStatut {
  BROUILLON
  ENVOYE
  CONSULTE
  SIGNE
  REFUSE
  TERMINE
}

enum MoyenPaiement {
  SEPA
  CARTE
  VIREMENT
  LIEN
  AUTRE
}

/// Brief collaboratif d'un site : rempli par le commercial, complété par le client, validé par le commercial puis par Arsène.
enum BriefEtat {
  EN_COURS
  ATTENDU_CLIENT
  COMPLET
  VALIDE
}

/// Circuits de validation à deux niveaux (section 20.1 du prompt maître).
enum ValidationType {
  BRIEF_COMMERCIAL
  BRIEF_TECHNIQUE
  MAQUETTE
  DEROGATION_PAIEMENT_COMMERCIALE
  DEROGATION_PAIEMENT_TECHNIQUE
  GO_LIVE
  EXCEPTION_TARIFAIRE
  LIVRABLE
  CAMPAGNE
}

enum ValidationStatut {
  EN_ATTENTE
  VALIDEE
  REFUSEE
}

enum TacheClientType {
  RELANCE
  RDV_A_PLANIFIER
  APPEL
  EMAIL
  DOCUMENT
  MAINTENANCE
  AUTRE
}

enum TacheClientStatut {
  A_FAIRE
  FAIT
  ANNULEE
}

enum CampagneStatut {
  BROUILLON
  VALIDEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum DestinataireStatut {
  EN_ATTENTE
  ENVOYE
  ERREUR
  EXCLU
}

/// Formule d'abonnement d'un client.
enum Formule {
  ESSENTIEL
  REFERENCE
  CONQUETE
  SIGNATURE
}

enum MembershipRole {
  OWNER // gérant
  MEMBER // employé invité
}

enum SiteStatus {
  EN_CREATION
  EN_LIGNE
  SUSPENDU
}

/// Pipeline de production d'un site (kanban « Sites en cours »). « Livré » n'est pas une étape : le site passe en ligne (status EN_LIGNE).
enum ProjectStep {
  CREER_MAQUETTE
  VALIDER_MAQUETTE
  MODIFIER
  VALIDER_MODIFICATION
  FINIR
  A_LIVRER
}

enum ArticleStatut {
  A_REDIGER // demandé (file d'attente « blogs demandés »)
  REDIGE // rédigé, à prévoir pour un lundi
  A_PUBLIER // prévu pour un lundi précis
  PUBLIE
}

enum AssetKind {
  LOGO
  TEXTE
  PHOTO
  AUTRE
}

enum HistoryKind {
  CREATION // récap de ce qui a été fait à la création
  INTERVENTION // intervention datée
  MISE_EN_LIGNE
}

enum ContactRequestStatus {
  NOUVELLE
  TRAITEE
  DEVENU_CLIENT
}

enum ChangeRequestStatus {
  RECUE
  EN_COURS
  A_VALIDER // Claude a terminé, en attente de validation par l'équipe
  TERMINEE
}

/// Suivi du travail de Claude Code sur une demande de modification (worker local, scripts/claude-worker.ts).
enum ClaudeJobState {
  EN_FILE // confiée à Claude, en attente du worker
  EN_TRAVAIL // Claude modifie le site
  PRET // modifs poussées sur la branche, aperçu disponible
  MISE_EN_LIGNE_DEMANDEE // validée : à fusionner dans la branche principale
  EN_LIGNE // fusionnée et poussée, le serveur publie
  ERREUR
  ANNULATION_DEMANDEE // l'équipe refuse le travail de Claude : le worker supprime la branche et l'aperçu
}

enum Urgency {
  NORMALE
  URGENTE
}

enum ReviewSource {
  GOOGLE
  DEMO
}

enum Module {
  NONE
  AVIS
}

enum Billing {
  PONCTUEL
  MENSUEL
}

enum OrderStatus {
  A_TRAITER
  VALIDEE
  REFUSEE
}

enum SubscriptionStatus {
  ACTIF
  RESILIE
}

enum DocumentKind {
  CONTRAT
  FACTURE
  DEVIS
  AUTRE
}

enum ReferralKind {
  LIEN
  CONTACT
}

enum ReferralStatus {
  ENVOYEE
  CONTACTEE
  SIGNEE
  RECOMPENSE_VALIDEE
}

enum ReviewPromptState {
  AFFICHEE
  IGNOREE
  CLIQUEE
}

enum NotificationKind {
  DEMANDE_CONTACT
  NOUVEL_AVIS
  MODIFICATION_TERMINEE
  RECAP_MENSUEL
  MESSAGE_EQUIPE
  SITE_EN_LIGNE
  COMMANDE_VALIDEE
  RECOMPENSE_PARRAINAGE
  ALERTE_SITE
  DOCUMENT_DISPONIBLE
  DOCUMENT_DEMANDE
  MAQUETTE_DISPONIBLE
}

/// VERS_EQUIPE : le client demande un document à Acco. VERS_CLIENT : Acco demande un document au client.
enum DocumentRequestDirection {
  VERS_EQUIPE
  VERS_CLIENT
}

enum DocumentRequestStatus {
  EN_ATTENTE
  TERMINEE
}

// ─────────────────────────────────────────────────────────────
// Comptes
// ─────────────────────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  name            String // raison sociale / enseigne
  siren           String?
  address         String?
  phone           String?
  email           String?
  commercialId    String? // « Suivi par … »
  developpeurId   String? // développeur attitré
  formule         Formule?
  engagementDebut DateTime?
  engagementFin   DateTime?
  gmbUrl          String? // fiche Google Business Profile
  reference       Boolean      @default(false) // client référence : épinglé en tête de liste, appui pour les argumentaires
  alerteContactAt DateTime? // dernière alerte « aucun contact depuis 60 jours » envoyée au commercial
  logoPath        String? // logo déposé (bucket documents, dossier logos/<clientId>), recadré carré côté serveur
  logoMiniPath    String? // miniature 128 px générée une fois
  secteur         String? // activité / métier
  statut          ClientStatut @default(ACTIF)
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  commercial    User?                  @relation("ClientCommercial", fields: [commercialId], references: [id], onDelete: SetNull)
  developpeur   User?                  @relation("ClientDeveloppeur", fields: [developpeurId], references: [id], onDelete: SetNull)
  loginLogs     LoginLog[]
  activites     Activite[]
  contrats      Contrat[]
  contacts      ProspectContact[]
  delegations   Delegation[]
  taches        TacheClient[]
  validations   Validation[]
  rendezVous    RendezVous[]
  destinataires CampagneDestinataire[]

  memberships      ClientMembership[]
  invitations      Invitation[]
  sites            Site[]
  orders           Order[]
  subscriptions    Subscription[]
  conversation     Conversation?
  documents        Document[]
  documentRequests DocumentRequest[]
  referralsMade    Referral[]         @relation("ReferralsMade")
  referredBy       Referral?          @relation("ReferredClient")
  reviewPrompts    ReviewPrompt[]
  notifications    Notification[]
  referralCode     String             @unique @default(cuid())
  crmProspect      Prospect?
  crmEchanges      Echange[]
  crmProjets       Projet[]
}

model User {
  id                 String   @id // = auth.users.id (Supabase Auth)
  email              String   @unique
  firstName          String?
  lastName           String?
  avatarUrl          String?
  role               Role     @default(CLIENT)
  droits             String[] @default([]) // droits unitaires en plus du rôle : pilotage, equipe, reglages, validation_commerciale, go_live, dates_production, finance, ia_admin (src/lib/permissions.ts)
  modeDefaut         Mode? // vue de travail au démarrage (Bilel : Commercial, Arsène : Production)
  googleRefreshToken String? // compte Google personnel (équipe) : lecture de sa boîte Gmail pour l'historique des fiches CRM
  googleEmail        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships          ClientMembership[]
  invitationsSent      Invitation[]
  messages             Message[]
  assignedChanges      ChangeRequest[]         @relation("AssignedChanges")
  changeComments       ChangeRequestComment[]
  pushSubscriptions    PushSubscription[]
  notificationPref     NotificationPreference?
  historyEntries       SiteHistoryEntry[]
  validatedOrders      Order[]                 @relation("ValidatedOrders")
  documentRequests     DocumentRequest[]
  crmProspects         Prospect[]              @relation("ProspectCommercial")
  crmEchanges          Echange[]               @relation("EchangeAuteur")
  crmRendezVous        RendezVous[]            @relation("RdvCommercial")
  crmProjets           Projet[]                @relation("ProjetResponsable")
  crmTaches            Tache[]                 @relation("TacheResponsable")
  crmTacheModeles      TacheModele[]           @relation("TacheModeleResponsable")
  leadListes           LeadListe[]             @relation("LeadListeCommercial")
  leadListesCreees     LeadListe[]             @relation("LeadListeAuteur")
  clientsSuivis        Client[]                @relation("ClientCommercial")
  clientsDeveloppes    Client[]                @relation("ClientDeveloppeur")
  loginLogs            LoginLog[]
  sitesDeveloppes      Site[]                  @relation("SiteDeveloppeur")
  articles             Article[]
  activites            Activite[]
  agendaEvents         AgendaEvent[]
  contratsCrees        Contrat[]               @relation("ContratCreePar")
  contratsSuivis       Contrat[]               @relation("ContratCommercial")
  delegationsDe        Delegation[]            @relation("DelegationDe")
  delegationsVers      Delegation[]            @relation("DelegationVers")
  tachesClient         TacheClient[]           @relation("TacheClientResponsable")
  validationsAssignees Validation[]            @relation("ValidationAssigne")
  validationsDecidees  Validation[]            @relation("ValidationDecidePar")
  campagnes            Campagne[]
  vues                 SavedView[]
  usagesIA             UsageIA[]
}

/// Contrat (plusieurs par client) : généré par l'app (PDF), signé par acceptation en ligne ou scan, archivé immuable.
/// Un avenant est un nouveau Contrat dont parentId pointe sur le contrat d'origine (version précédente conservée).
model Contrat {
  id                      String         @id @default(cuid())
  reference               String         @unique // ex. ACCO-2026-0012
  clientId                String?
  prospectId              String?
  siteId                  String?
  parentId                String? // avenant d'un contrat existant
  version                 Int            @default(1)
  statut                  ContratStatut  @default(BROUILLON)
  titre                   String
  formule                 Formule?
  montantMensuelHt        Int            @default(0) // centimes
  montantPonctuelHt       Int            @default(0) // centimes (création, prestations ponctuelles)
  moyenPaiement           MoyenPaiement?
  dureeMois               Int            @default(24)
  reconductionMois        Int            @default(24)
  preavisJours            Int            @default(30)
  debutEngagement         DateTime?
  finEngagement           DateTime?
  contenu                 Json? // clauses et variables du modèle au moment de la génération
  pdfPath                 String? // PDF généré (bucket documents)
  pdfSha256               String? // empreinte du PDF exact accepté
  certificatPath          String? // certificat de preuve PDF
  scanPath                String? // PDF signé à la main et scanné
  token                   String         @unique @default(cuid()) // lien sécurisé d'acceptation
  otpHash                 String?
  otpExpiresAt            DateTime?
  envoyeAt                DateTime?
  consulteAt              DateTime?
  signeAt                 DateTime?
  signataireNom           String?
  signataireEmail         String?
  signataireIp            String?
  signataireUa            String?
  refuseAt                DateTime?
  refusMotif              String?
  premierPaiementAt       DateTime?
  premierPaiementParId    String?
  premierPaiementAnnuleAt DateTime?
  impayeAt                DateTime?
  impayeParId             String?
  regulariseAt            DateTime?
  sourceFinanciere        String         @default("manuelle") // manuelle | connecteur (futur)
  externalId              String? // identifiant dans un futur outil de facturation
  majFinanciereAt         DateTime?
  commercialId            String?
  createdById             String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  prospect      Prospect?      @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  site          Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  parent        Contrat?       @relation("Avenant", fields: [parentId], references: [id], onDelete: SetNull)
  avenants      Contrat[]      @relation("Avenant")
  commercial    User?          @relation("ContratCommercial", fields: [commercialId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("ContratCreePar", fields: [createdById], references: [id], onDelete: SetNull)
  lignes        LigneContrat[]
  subscriptions Subscription[]
  validations   Validation[]

  @@index([clientId, statut])
  @@index([prospectId])
  @@index([statut])
}

/// Ligne de service d'un contrat : une offre (ou libellé libre), un montant HT, éventuellement ciblée sur un site.
model LigneContrat {
  id        String  @id @default(cuid())
  contratId String
  offerId   String?
  siteId    String?
  libelle   String
  billing   Billing
  montantHt Int // centimes
  quantite  Int     @default(1)
  ordre     Int     @default(0)

  contrat Contrat @relation(fields: [contratId], references: [id], onDelete: Cascade)
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)
  site    Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([contratId])
}

/// Brief collaboratif d'un site (ouvert à la signature) : contenu structuré, états, double validation.
model Brief {
  id                   String    @id @default(cuid())
  siteId               String    @unique
  etat                 BriefEtat @default(EN_COURS)
  contenu              Json? // sections : activité, cibles, pages, textes, photos, préférences, concurrents, contacts…
  validCommercialParId String?
  validCommercialAt    DateTime?
  validTechniqueParId  String?
  validTechniqueAt     DateTime?
  derogationNote       String? // points non essentiels levés par Arsène (carte blanche), justification
  derogationParId      String?
  derogationAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

/// Validation demandée à une personne (ou à son délégataire) : un clic depuis « En attente de ma validation ».
model Validation {
  id           String           @id @default(cuid())
  type         ValidationType
  statut       ValidationStatut @default(EN_ATTENTE)
  clientId     String?
  siteId       String?
  contratId    String?
  objetId      String? // id libre (campagne, article…)
  assigneId    String
  delegueAId   String?
  demandeParId String?
  commentaire  String?
  decideParId  String?
  decideAt     DateTime?
  motif        String?
  createdAt    DateTime         @default(now())

  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contrat   Contrat? @relation(fields: [contratId], references: [id], onDelete: Cascade)
  assigne   User     @relation("ValidationAssigne", fields: [assigneId], references: [id], onDelete: Cascade)
  decidePar User?    @relation("ValidationDecidePar", fields: [decideParId], references: [id], onDelete: SetNull)

  @@index([assigneId, statut])
  @@index([siteId, type, statut])
}

/// Délégation temporaire du portefeuille d'un commercial (retour automatique à la fin).
model Delegation {
  id          String   @id @default(cuid())
  clientId    String? // vide = tout le portefeuille du commercial
  deId        String
  versId      String
  debut       DateTime
  fin         DateTime
  motif       String?
  createdById String?
  createdAt   DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  de     User    @relation("DelegationDe", fields: [deId], references: [id], onDelete: Cascade)
  vers   User    @relation("DelegationVers", fields: [versId], references: [id], onDelete: Cascade)

  @@index([versId, fin])
  @@index([deId, fin])
}

/// Tâche commerciale ou de maintenance rattachée à un client (après signature), avec sa source.
model TacheClient {
  id            String            @id @default(cuid())
  clientId      String
  siteId        String?
  contratId     String?
  type          TacheClientType   @default(AUTRE)
  titre         String
  description   String?
  echeance      DateTime?
  statut        TacheClientStatut @default(A_FAIRE)
  responsableId String?
  source        String? // rdv, email, appel, campagne, maquette, livraison, saisie
  recurrence    Recurrence        @default(PONCTUEL)
  faitAt        DateTime?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site        Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  responsable User?  @relation("TacheClientResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([responsableId, statut, echeance])
  @@index([clientId, statut])
}

/// Envoi groupé d'emails à de petites sélections de clients, via Gmail, validé par un humain avant départ.
model Campagne {
  id           String         @id @default(cuid())
  titre        String
  objet        String
  corpsHtml    String // modèle avec variables {{prenom}} {{societe}} {{site}} {{commercial}}
  commercial   Boolean        @default(true) // message commercial (désinscription appliquée) ou transactionnel
  statut       CampagneStatut @default(BROUILLON)
  plafond      Int            @default(50)
  auteurId     String?
  validParId   String?
  validAt      DateTime?
  envoiDebutAt DateTime?
  envoiFinAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  auteur        User?                  @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  destinataires CampagneDestinataire[]
}

model CampagneDestinataire {
  id         String             @id @default(cuid())
  campagneId String
  clientId   String
  contactId  String?
  email      String
  statut     DestinataireStatut @default(EN_ATTENTE)
  gmailId    String?
  erreur     String?
  envoyeAt   DateTime?

  campagne Campagne @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([campagneId, statut])
}

/// Vue enregistrée d'une liste (filtres, tri, colonnes), par utilisateur.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  espace    String // clients, prospects, taches
  nom       String
  params    Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, espace])
}

/// Consommation IA : un enregistrement par appel (compteur et plafond mensuel dans Administration > IA et intégrations).
enum ChargeType {
  MENSUELLE
  PONCTUELLE
}

/// Charges de l'entreprise saisies à la main (00.10 §4) : récurrentes, fixes principales, ponctuelles. Historique conservé (archivage).
model Charge {
  id           String     @id @default(cuid())
  nom          String
  categorie    String // logiciels, salaires, local, sous_traitance, marketing, autre
  type         ChargeType @default(MENSUELLE)
  montantCents Int
  principale   Boolean    @default(false)
  debut        DateTime // charge mensuelle : premier mois ; ponctuelle : date de la dépense
  fin          DateTime?
  commentaire  String?
  clientId     String? // coût rattaché à un client / projet (prestataire…) : remonte dans la rentabilité
  archivedAt   DateTime?
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([type, archivedAt])
}

model UsageIA {
  id           String   @id @default(cuid())
  fonction     String // recap, conseils, enrichissement, leads, synthese_client, brouillon_email…
  modele       String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  coutCents    Int      @default(0)
  userId       String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([fonction, createdAt])
}

/// Journal des connecteurs externes (Gmail, Calendar, Aircall, Search Console…) : état, dernière synchro, erreurs.
model ConnecteurLog {
  id         String   @id @default(cuid())
  connecteur String
  niveau     String // info | erreur
  message    String
  createdAt  DateTime @default(now())

  @@index([connecteur, createdAt])
}

/// Événements poussés dans le Google Agenda personnel d'un membre (RDV, échéances de sites) : clé interne → id Google.
model AgendaEvent {
  id            String   @id @default(cuid())
  userId        String
  cle           String // rdv:<id>, site:<id>:v1 | v2 | livraison
  googleEventId String
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cle])
}

/// Article de blog d'un site : suivi de publication (Production → Blogs).
model Article {
  id                String        @id @default(cuid())
  siteId            String
  titre             String
  url               String?
  statut            ArticleStatut @default(A_REDIGER)
  publieAt          DateTime?
  demandeClient     Boolean       @default(false) // commandé par le client depuis son portail
  consignes         String?
  approbationClient Boolean       @default(false) // le client veut relire le texte avant publication
  prevuPour         DateTime? // lundi de publication prévu (un seul article par lundi et par site)
  contenu           String? // texte rédigé (markdown)
  motsCles          String?
  genereParIA       Boolean       @default(false)
  auteurId          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  site   Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  auteur User? @relation(fields: [auteurId], references: [id], onDelete: SetNull)

  @@index([siteId, statut])
  @@unique([siteId, prevuPour])
}

/// Flux d'activité de l'agence : tâches terminées, étapes franchies, notes, statuts… (Production et Pilotage).
model Activite {
  id        String   @id @default(cuid())
  kind      String // site_etape, site_statut, modification, article, compte_rendu, prospect…
  texte     String
  href      String?
  userId    String?
  clientId  String?
  siteId    String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([clientId, createdAt])
}

/// Journal des connexions (qui se connecte, quand) : affiché sur la fiche client, purgé après 6 mois (cron rgpd).
model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  clientId  String?
  userAgent String?
  at        DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, at])
  @@index([userId, at])
}

model ClientMembership {
  id        String         @id @default(cuid())
  clientId  String
  userId    String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([userId])
}

model Invitation {
  id         String    @id @default(cuid())
  clientId   String
  email      String
  token      String    @unique @default(cuid())
  invitedBy  String?
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  inviter User?  @relation(fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────
// Sites
// ─────────────────────────────────────────────────────────────

model Site {
  id                   String      @id @default(cuid())
  clientId             String
  name                 String
  url                  String? // URL de production
  previewUrl           String? // lien préprod
  screenshotUrl        String?
  status               SiteStatus  @default(EN_CREATION)
  projectStep          ProjectStep @default(CREER_MAQUETTE)
  etapeAt              DateTime? // dernier changement d'étape
  developpeurId        String? // développeur attitré au projet
  deadlineV1           DateTime? // présentation de la V1
  deadlineV2           DateTime? // V2 (après peaufinement / validation client)
  deadlineLivraison    DateTime?
  conseils             Json? // conseils business (espace client), regénérés chaque semaine
  conseilsAt           DateTime?
  mockupValidatedAt    DateTime?
  version              Int         @default(1) // V1, V2, V3…
  maquetteEnvoyeeAt    DateTime? // clic explicite « Envoyer maquette » : seulement alors le lien est visible du client
  maquetteEnvoyeeParId String?
  goLiveAutoriseAt     DateTime? // autorisation technique de mise en ligne (Arsène)
  goLiveAutoriseParId  String?
  receptionPath        String? // document de réception de livraison signé
  receptionSigneeAt    DateTime?
  contratId            String? // contrat de référence
  launchedAt           DateTime?
  siteKey              String      @unique @default(cuid()) // clé des formulaires
  searchConsoleProp    String? // ex. sc-domain:example.fr
  recapAuto            Boolean     @default(false) // récap mensuel envoyé tout seul le 4 (activé par une synchro réussie)
  blogAuto             Boolean     @default(false) // blogs automatiques : rédaction des demandes (ou d'un sujet proposé) et mise en attente pour le lundi suivant
  googleLocationId     String? // fiche Google Business Profile
  reviewsSyncedAt      DateTime?
  reviewAverage        Float?
  reviewTotal          Int?
  repoUrl              String? // dépôt GitHub du site, ex. https://github.com/arsnplp/swella.git
  repoBranch           String? // branche publiée (défaut : main)
  repoRoot             String? // sous-dossier servi en ligne (ex. « site »), vide = racine
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  client           Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  developpeur      User?                @relation("SiteDeveloppeur", fields: [developpeurId], references: [id], onDelete: SetNull)
  articles         Article[]
  activites        Activite[]
  brief            Brief?
  contrats         Contrat[]
  lignesContrat    LigneContrat[]
  validations      Validation[]
  taches           TacheClient[]
  rendezVous       RendezVous[]
  assets           SiteAsset[]
  history          SiteHistoryEntry[]
  healthChecks     SiteHealthCheck[]
  contactRequests  ContactRequest[]
  searchStats      SearchStatsMonthly[]
  recaps           MonthlyRecap[]
  reviews          Review[]
  changeRequests   ChangeRequest[]
  guideProgress    GuideProgress[]
  subscriptions    Subscription[]
  orders           Order[]
  messages         Message[]
  documents        Document[]
  documentRequests DocumentRequest[]
  notifications    Notification[]
  crmProjets       Projet[]

  @@index([clientId])
}

model SiteAsset {
  id          String    @id @default(cuid())
  siteId      String
  kind        AssetKind
  label       String // "Logo", "Textes de la page d'accueil", ...
  storagePath String? // null = pas encore fourni
  fileName    String?
  uploadedAt  DateTime?
  createdAt   DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model SiteHistoryEntry {
  id          String      @id @default(cuid())
  siteId      String
  kind        HistoryKind
  title       String
  description String?
  items       String[] // puces (pages créées, SEO technique, ...)
  happenedAt  DateTime    @default(now())
  authorId    String?
  createdAt   DateTime    @default(now())

  site   Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([siteId, happenedAt])
}

model SiteHealthCheck {
  id           String    @id @default(cuid())
  siteId       String
  isUp         Boolean
  statusCode   Int?
  responseMs   Int?
  sslExpiresAt DateTime?
  checkedAt    DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, checkedAt])
}

// ─────────────────────────────────────────────────────────────
// Activité (formulaires des sites) — RGPD : purge à 24 mois
// ─────────────────────────────────────────────────────────────

model ContactRequest {
  id        String               @id @default(cuid())
  siteId    String
  name      String
  email     String?
  phone     String?
  type      String? // "Devis", "Rendez-vous", "Question"...
  message   String
  pageUrl   String?
  status    ContactRequestStatus @default(NOUVELLE)
  handledAt DateTime?
  createdAt DateTime             @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Résultats (Search Console)
// ─────────────────────────────────────────────────────────────

model SearchStatsMonthly {
  id          String   @id @default(cuid())
  siteId      String
  year        Int
  month       Int // 1-12
  clicks      Int // visites depuis Google
  impressions Int // apparitions
  position    Float // position moyenne
  topQueries  Json // [{ query, clicks, impressions, position }]
  createdAt   DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, year, month])
}

model MonthlyRecap {
  id           String    @id @default(cuid())
  siteId       String
  year         Int
  month        Int
  summary      String // 3 phrases générées par l'IA
  contactCount Int       @default(0)
  reviewCount  Int       @default(0)
  clicks       Int       @default(0)
  isPositive   Boolean   @default(false)
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, year, month])
}

// ─────────────────────────────────────────────────────────────
// Avis (module AVIS)
// ─────────────────────────────────────────────────────────────

model Review {
  id             String       @id @default(cuid())
  siteId         String
  source         ReviewSource @default(DEMO)
  externalId     String? // id Google
  authorName     String
  authorPhotoUrl String?
  rating         Int // 1-5
  text           String?
  reply          String?
  repliedAt      DateTime?
  suggestedReply String?
  publishedAt    DateTime
  createdAt      DateTime     @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, externalId])
  @@index([siteId, publishedAt])
}

// ─────────────────────────────────────────────────────────────
// Demandes de modification
// ─────────────────────────────────────────────────────────────

model ChangeRequest {
  id          String              @id @default(cuid())
  siteId      String
  title       String
  description String
  page        String?
  urgency     Urgency             @default(NORMALE)
  status      ChangeRequestStatus @default(RECUE)
  assigneeId  String?
  startedAt   DateTime?
  completedAt DateTime?
  confirmedAt DateTime? // le client confirme
  reopenedAt  DateTime?

  // Claude Code
  claudeState      ClaudeJobState?
  claudeBranch     String? // ex. claude/<id>
  claudeSummary    String? // compte rendu de Claude
  claudeFeedback   String? // consignes de l'équipe pour refaire
  claudeError      String?
  claudePreviewUrl String? // lien d'aperçu (localhost sur la machine du worker)
  claudeCompareUrl String? // diff GitHub
  claudeStartedAt  DateTime?
  claudeFinishedAt DateTime?
  claudeMergedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site        Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignee    User?                     @relation("AssignedChanges", fields: [assigneeId], references: [id], onDelete: SetNull)
  attachments ChangeRequestAttachment[]
  comments    ChangeRequestComment[]

  @@index([siteId, status])
  @@index([status])
  @@index([claudeState])
}

model ChangeRequestAttachment {
  id              String   @id @default(cuid())
  changeRequestId String
  storagePath     String
  fileName        String
  mimeType        String?
  createdAt       DateTime @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId])
}

model ChangeRequestComment {
  id              String   @id @default(cuid())
  changeRequestId String
  authorId        String?
  body            String
  createdAt       DateTime @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([changeRequestId])
}

// ─────────────────────────────────────────────────────────────
// Conseils
// ─────────────────────────────────────────────────────────────

model Guide {
  id          String   @id @default(cuid())
  slug        String   @unique
  emoji       String?
  title       String
  intro       String
  steps       String[] // cases à cocher
  offerId     String? // « On s'en occupe pour vous »
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  offer    Offer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  progress GuideProgress[]
}

model GuideProgress {
  id           String   @id @default(cuid())
  guideId      String
  siteId       String
  checkedSteps Int[] // index des étapes cochées
  updatedAt    DateTime @updatedAt

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  site  Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([guideId, siteId])
}

// ─────────────────────────────────────────────────────────────
// Offres, promos, commandes, abonnements
// ─────────────────────────────────────────────────────────────

model Offer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  benefit     String // bénéfice en une phrase
  description String?
  priceCents  Int
  setupCents  Int? // prix fixe (ex. plaquette NFC) en plus du mensuel
  billing     Billing
  module      Module   @default(NONE)
  isArchived  Boolean  @default(false)
  order       Int      @default(0)
  parentId    String? // offre complémentaire d'une autre offre (ex. Blog, complément de Site) : facultatif
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent        Offer?         @relation("OffreComplement", fields: [parentId], references: [id], onDelete: SetNull)
  complements   Offer[]        @relation("OffreComplement")
  lignesContrat LigneContrat[]
  promotions    Promotion[]
  orders        Order[]
  subscriptions Subscription[]
  guides        Guide[]
}

model Promotion {
  id              String   @id @default(cuid())
  offerId         String
  label           String // "Offre de rentrée"
  promoPriceCents Int? // prix barré → nouveau prix
  percentOff      Int? // ou remise en %
  startsAt        DateTime @default(now())
  endsAt          DateTime
  createdAt       DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([endsAt])
}

model Order {
  id            String      @id @default(cuid())
  clientId      String
  offerId       String
  siteId        String? // site choisi pour le module
  status        OrderStatus @default(A_TRAITER)
  note          String?
  validatedById String?
  validatedAt   DateTime?
  createdAt     DateTime    @default(now())

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offer       Offer  @relation(fields: [offerId], references: [id])
  site        Site?  @relation(fields: [siteId], references: [id], onDelete: SetNull)
  validatedBy User?  @relation("ValidatedOrders", fields: [validatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([clientId])
}

model Subscription {
  id               String             @id @default(cuid())
  clientId         String
  siteId           String?
  offerId          String?
  label            String // "Site vitrine — abonnement", "Module Avis Google"
  module           Module             @default(NONE)
  billing          Billing
  priceCents       Int
  monthlyQuota     Int? // quota de modifications / mois
  status           SubscriptionStatus @default(ACTIF)
  startedAt        DateTime           @default(now())
  commitmentEndsAt DateTime? // fin d'engagement
  cancelledAt      DateTime?
  contratId        String? // contrat d'origine de la ligne
  sourceFinanciere String             @default("manuelle")
  externalId       String?
  updatedAt        DateTime           @default(now()) @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site    Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  offer   Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  contrat Contrat? @relation(fields: [contratId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([siteId, module, status])
}

// ─────────────────────────────────────────────────────────────
// Messages
// ─────────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  clientId      String    @unique
  lastMessageAt DateTime?
  clientReadAt  DateTime?
  teamReadAt    DateTime?
  createdAt     DateTime  @default(now())

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String?
  siteId         String?
  body           String
  attachments    Json? // [{ storagePath, fileName, mimeType }]
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Documents
// ─────────────────────────────────────────────────────────────

model Document {
  id               String       @id @default(cuid())
  clientId         String
  siteId           String?
  kind             DocumentKind
  title            String
  storagePath      String
  fileName         String
  sizeBytes        Int?
  uploadedByClient Boolean      @default(false)
  createdAt        DateTime     @default(now())

  client  Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site    Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  request DocumentRequest?

  @@index([clientId])
  @@index([siteId])
}

/// Demande de document faite par le client (ex. « ma facture de septembre »)
model DocumentRequest {
  id          String                   @id @default(cuid())
  clientId    String
  siteId      String?
  kind        DocumentKind
  message     String?
  status      DocumentRequestStatus    @default(EN_ATTENTE)
  direction   DocumentRequestDirection @default(VERS_EQUIPE)
  requestedBy String?
  documentId  String?                  @unique
  fulfilledAt DateTime?
  createdAt   DateTime                 @default(now())

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site      Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  requester User?     @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Parrainage et avis sur Acco
// ─────────────────────────────────────────────────────────────

model Referral {
  id               String         @id @default(cuid())
  referrerClientId String
  kind             ReferralKind
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  note             String?
  referredClientId String?        @unique // rempli quand le filleul crée son compte
  status           ReferralStatus @default(ENVOYEE)
  rewardLabel      String?
  rewardedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  referrer Client  @relation("ReferralsMade", fields: [referrerClientId], references: [id], onDelete: Cascade)
  referred Client? @relation("ReferredClient", fields: [referredClientId], references: [id], onDelete: SetNull)

  @@index([referrerClientId])
}

model ReviewPrompt {
  id       String            @id @default(cuid())
  clientId String
  trigger  String // "SITE_EN_LIGNE", "MODIFICATION_CONFIRMEE", "RECAP_POSITIF"
  state    ReviewPromptState @default(AFFICHEE)
  shownAt  DateTime          @default(now())
  actedAt  DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, shownAt])
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  clientId  String
  siteId    String?
  kind      NotificationKind
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site   Site?  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  userId          String  @id
  pushEnabled     Boolean @default(true)
  emailEnabled    Boolean @default(true)
  contactRequests Boolean @default(true)
  reviews         Boolean @default(true)
  changes         Boolean @default(true)
  recaps          Boolean @default(true)
  messages        Boolean @default(true)
  offers          Boolean @default(true)
  documents       Boolean @default(true) // client : document mis à disposition / admin : document envoyé par un client
  referrals       Boolean @default(true) // admin : nouvelle recommandation

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Paramètres de l'agence
// ─────────────────────────────────────────────────────────────

model Setting {
  key       String   @id // "google_review_url", "referral_reward_label", ...
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Espace Commercial (CRM) : prospection et production.
// Tables à part : rien ici ne modifie le fonctionnement du portail.
// ─────────────────────────────────────────────────────────────

enum ProspectStatut {
  A_CONTACTER
  A_RELANCER
  POSER_RDV
  RDV_POSE
  A_SIGNER
  GAGNE
  PERDU
  ABANDON // écarté proprement (sans supprimer), distinct de Perdu : repêchable depuis « Tous les prospects »
}

enum ProspectSource {
  COLD_CALL
  PROSPECTION_PHYSIQUE
  RECOMMANDATION
  SITE_WEB
  AUTRE
}

enum EchangeType {
  NRP // ne répond pas
  APPEL
  MAIL
  PP // prospection physique
  RDV // le rendez-vous a eu lieu
  PRISE_RDV
  NO_SHOW // le prospect n'est pas venu au RDV (ne compte pas comme RDV pris)
  NOTE
}

enum RdvResultat {
  PREVU
  FAIT
  NO_SHOW
  ANNULE
}

enum Priorite {
  BASSE
  MOYENNE
  HAUTE
}

enum ProjetStatut {
  A_FAIRE
  EN_COURS
  EN_PAUSE
  TERMINE
}

enum TacheStatut {
  A_FAIRE
  EN_COURS
  FAIT
}

enum Recurrence {
  PONCTUEL
  HEBDOMADAIRE
  MENSUEL_FIXE // le N du mois
  MENSUEL_RELATIF // le 1er lundi du mois…
}

model Cible {
  id        String     @id @default(cuid())
  nom       String     @unique
  createdAt DateTime   @default(now())
  prospects Prospect[]
}

model Prospect {
  id                 String          @id @default(cuid())
  legacyId           String?         @unique // ID de l'ancien CRM (import)
  societe            String
  siren              String?
  siret              String?
  dirigeant          String?
  adresse            String?
  siteWeb            String?
  telephone          String?
  cibleId            String?
  source             ProspectSource?
  statut             ProspectStatut  @default(A_CONTACTER)
  motifPerte         String?
  potentielEuros     Int? // potentiel mensuel estimé
  fraisCreationEuros Int? // signé : frais de création
  mensuelEuros       Int? // signé : abonnement mensuel
  commercialId       String?
  relanceAt          DateTime?
  rappelAt           DateTime? // heure de relance précise : notification au commercial à cette heure
  rappelEnvoyeAt     DateTime? // push envoyé
  clientId           String?         @unique // rempli quand le prospect devient client du portail
  gagneAt            DateTime?
  perduAt            DateTime?
  abandonAt          DateTime?
  infos              Json? // « Générer les infos » : enrichissement d'une fiche créée à la main (mêmes colonnes qu'un lead du coffre)
  infosAt            DateTime?
  syncAt             DateTime? // dernière synchronisation Aircall + emails de la fiche
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  cible      Cible?            @relation(fields: [cibleId], references: [id], onDelete: SetNull)
  commercial User?             @relation("ProspectCommercial", fields: [commercialId], references: [id], onDelete: SetNull)
  client     Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contacts   ProspectContact[]
  echanges   Echange[]
  rendezVous RendezVous[]
  contrats   Contrat[]
  lead       Lead?

  @@index([statut, relanceAt])
  @@index([rappelAt])
  @@index([commercialId])
  @@index([siren])
  @@index([telephone])
}

/// Contact d'un prospect et/ou d'un client (même ligne avant et après signature : une seule source de vérité).
model ProspectContact {
  id               String   @id @default(cuid())
  prospectId       String?
  clientId         String?
  prenom           String?
  nom              String?
  fonction         String?
  email            String?
  telephone        String?
  principal        Boolean  @default(false)
  optOutCommercial Boolean  @default(false) // ne plus recevoir de messages commerciaux (désinscription)
  createdAt        DateTime @default(now())

  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@index([clientId])
}

model Echange {
  id         String      @id @default(cuid())
  legacyId   String?     @unique
  prospectId String?
  clientId   String? // échange avec un client sans fiche prospect (historique importé)
  type       EchangeType
  notes      String?
  date       DateTime    @default(now())
  auteurId   String?
  auteurNom  String? // auteur externe (mail entrant)
  origine    String      @default("saisie") // saisie, import, lead, aircall, gmail
  externalId String?     @unique // aircall:<id d'appel>, gmail:<id de message> : évite les doublons à la synchronisation
  meta       Json? // Aircall : durée, enregistrement, résumé IA, sujets, sentiment, transcription ; Gmail : objet, expéditeur, extrait
  createdAt  DateTime    @default(now())

  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  auteur   User?     @relation("EchangeAuteur", fields: [auteurId], references: [id], onDelete: SetNull)

  @@index([prospectId, date])
  @@index([clientId, date])
  @@index([auteurId, date])
}

model RendezVous {
  id            String      @id @default(cuid())
  prospectId    String?
  clientId      String? // RDV avec un client signé (présentation de maquette, suivi, livraison…)
  siteId        String?
  commercialId  String?
  titre         String?
  debut         DateTime
  dureeMin      Int         @default(60)
  lieu          String?
  meetUrl       String?
  googleEventId String? // événement créé ou lu dans Google Agenda (synchro bidirectionnelle)
  resultat      RdvResultat @default(PREVU)
  reportDeId    String? // RDV recalé après un no show : ne compte pas comme un nouveau RDV pris
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  prospect   Prospect?    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  client     Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site       Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  commercial User?        @relation("RdvCommercial", fields: [commercialId], references: [id], onDelete: SetNull)
  reportDe   RendezVous?  @relation("RdvReport", fields: [reportDeId], references: [id], onDelete: SetNull)
  reports    RendezVous[] @relation("RdvReport")

  @@index([debut])
}

model ProjetModele {
  id          String        @id @default(cuid())
  legacyId    String?       @unique
  nom         String
  description String?
  createdAt   DateTime      @default(now())
  taches      TacheModele[]
  projets     Projet[]
}

model TacheModele {
  id            String     @id @default(cuid())
  legacyId      String?    @unique
  modeleId      String
  titre         String
  description   String?
  responsableId String?
  priorite      Priorite   @default(MOYENNE)
  recurrence    Recurrence @default(PONCTUEL)
  jourSemaine   Int? // 1 = lundi … 7 = dimanche
  jourMois      Int? // 1 … 31
  positionMois  Int? // 1 = 1er … 5 = dernier (avec jourSemaine)
  delaiJours    Int        @default(0) // échéance = début du projet + délai
  ordre         Int        @default(0)

  modele      ProjetModele      @relation(fields: [modeleId], references: [id], onDelete: Cascade)
  responsable User?             @relation("TacheModeleResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  sousTaches  SousTacheModele[]
  taches      Tache[]

  @@index([modeleId])
}

model SousTacheModele {
  id       String  @id @default(cuid())
  legacyId String? @unique
  tacheId  String
  intitule String
  ordre    Int     @default(0)

  tache TacheModele @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@index([tacheId])
}

model Projet {
  id            String       @id @default(cuid())
  legacyId      String?      @unique
  clientId      String?
  siteId        String?
  modeleId      String?
  nom           String
  description   String?
  statut        ProjetStatut @default(EN_COURS)
  priorite      Priorite     @default(MOYENNE)
  debut         DateTime?
  echeance      DateTime?
  responsableId String?
  brief         Json? // formulaire de cadrage
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  site        Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  modele      ProjetModele? @relation(fields: [modeleId], references: [id], onDelete: SetNull)
  responsable User?         @relation("ProjetResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  taches      Tache[]

  @@index([clientId])
}

model Tache {
  id            String      @id @default(cuid())
  legacyId      String?     @unique
  projetId      String?
  modeleId      String?
  titre         String
  description   String?
  responsableId String?
  statut        TacheStatut @default(A_FAIRE)
  priorite      Priorite    @default(MOYENNE)
  debut         DateTime?
  echeance      DateTime?
  faitLe        DateTime?
  recurrence    Recurrence  @default(PONCTUEL)
  jourSemaine   Int?
  jourMois      Int?
  positionMois  Int?
  ordre         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  projet      Projet?      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  modele      TacheModele? @relation(fields: [modeleId], references: [id], onDelete: SetNull)
  responsable User?        @relation("TacheResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  sousTaches  SousTache[]

  @@index([responsableId, statut, echeance])
  @@index([projetId])
}

model SousTache {
  id       String  @id @default(cuid())
  legacyId String? @unique
  tacheId  String
  titre    String
  fait     Boolean @default(false)
  ordre    Int     @default(0)

  tache Tache @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@index([tacheId])
}

// ─── Coffre à leads : listes générées (recherche web + registre officiel), envoyées ensuite dans « À contacter » ───

enum LeadListeStatut {
  GENERATION
  PRETE
  ERREUR
  UTILISEE
}

model LeadListe {
  id             String          @id @default(cuid())
  secteur        String
  region         String
  demande        Int
  mobileSeul     Boolean         @default(false) // numéros mobiles (06 / 07) uniquement
  filtreSite     String? // SANS = sans site uniquement, AVEC = avec site uniquement, vide = peu importe
  obtenus        Int             @default(0)
  ecartes        Int             @default(0) // déjà dans le CRM, le portail ou le coffre
  estimationZone Int? // nombre d'entreprises de ce type estimé dans la zone
  statut         LeadListeStatut @default(GENERATION)
  message        String?
  erreur         String?
  recherches     Int             @default(0) // recherches web utilisées
  coutUsd        Float?
  commercialId   String?
  auteurId       String?
  utiliseeAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  commercial User?  @relation("LeadListeCommercial", fields: [commercialId], references: [id], onDelete: SetNull)
  auteur     User?  @relation("LeadListeAuteur", fields: [auteurId], references: [id], onDelete: SetNull)
  leads      Lead[]

  @@index([createdAt])
}

model Lead {
  id         String   @id @default(cuid())
  listeId    String
  entreprise String
  telephone  String?
  siteWeb    String?
  siren      String?
  ville      String?
  score      Int?
  donnees    Json // toutes les colonnes (Entreprise, Secteur, Ville, … Instagram)
  prospectId String?  @unique // rempli quand le lead part dans « À contacter »
  createdAt  DateTime @default(now())

  liste    LeadListe @relation(fields: [listeId], references: [id], onDelete: Cascade)
  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([listeId])
  @@index([siren])
  @@index([telephone])
}
